# Use the official PyTorch image with CUDA support
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

# Set the working directory inside the container
WORKDIR /app

# Prevent Python from writing pyc files and keep stdout unbuffered
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install web and MLflow dependencies directly
# (torch, torchvision, and Pillow are already included in this base image, 
# but python-multipart is explicitly required by FastAPI for file uploads)
RUN pip install --no-cache-dir fastapi uvicorn python-multipart

# Copy the FastAPI application code
COPY main.py .

# Expose the port the app runs on
EXPOSE 8000

# Command to run the FastAPI application using uvicorn directly
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]